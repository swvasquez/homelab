{
  "name": "homelab",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "workspaceFolder": "/workspaces/homelab",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // firewall.sh needs both capabilities to write iptables rules.
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],

  "mounts": [
    // Shadows the host's .venv, which holds Darwin binaries on macOS.
    "source=homelab-venv-${devcontainerId},target=/workspaces/homelab/.venv,type=volume",

    // `just devcontainer-up` replaces the container every time; the cache keeps each
    // reinstall to seconds (onigurumacffi has no wheel for this platform).
    "source=homelab-uv-cache-${devcontainerId},target=/home/vscode/.cache/uv,type=volume",

    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],

  "containerEnv": {
    // Claude Code keeps .claude.json outside ~/.claude by default, so without this
    // the volume above preserves settings but not the login.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",

    // The persistent .venv makes `uv venv` prompt before replacing it, which hangs
    // postCreateCommand with nothing attached to answer.
    "UV_VENV_CLEAR": "1"
  },

  // The settings are installed here rather than COPYed into the image because the
  // build context is .devcontainer/, which cannot reach a file at the repository
  // root; by this point the repository is mounted. /etc/claude-code is the highest
  // settings precedence, so a checked-out branch cannot edit it away.
  //
  // Volumes mount root-owned. -R because a volume ever written to as root keeps
  // root-owned subdirectories, which fail Claude Code's writes with EACCES.
  "postCreateCommand": "sudo install -D -m 0644 .claude/managed-settings.json /etc/claude-code/managed-settings.json && sudo chown -R vscode:vscode .venv ~/.cache/uv ~/.claude && just venv",

  "postStartCommand": "sudo /usr/local/bin/firewall.sh",

  // Claude Code refuses --dangerously-skip-permissions as root.
  "remoteUser": "vscode"
}
